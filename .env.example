APP_NAME="LIST"
APP_LOGO="images/app/fav.png"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"
APP_URL=https://invman.test

# Offline license. Exact domains and *.domain wildcards are supported.
# Host IP entries accept IPv4, IPv6, and CIDR ranges.
LICENSE_ALLOWED_DOMAINS="*.tarunabakti.or.id,invman.test"
LICENSE_ALLOWED_HOST_IPS="127.0.0.1,::1,10.10.1.0/24"
LICENSE_TOKEN=v1.eyJ2ZXJzaW9uIjoxLCJwcm9kdWN0IjoiaW52bWFuIiwibGljZW5zZV9pZCI6Ijc0NWE3MzY3LTNiZDktNDRmZi05NjM2LWRmNGYwMDI2YjYzOSIsImlzc3VlZF9hdCI6IjIwMjYtMDgtMzBUMTg6MzI6MjRaIiwiZG9tYWlucyI6WyIqLnRhcnVuYWJha3RpLm9yLmlkIiwiaW52bWFuLnRlc3QiXSwiaG9zdF9pcHMiOlsiMTAuMTAuMS4wLzI0IiwiMTI3LjAuMC4xIiwiOjoxIl19.nuJq3VciHES5w6XXxrOv3BLUH9VAAU83QThnNjni0nxm-NxM3BfuC_rSSF7wCC4FDelofo4AdkWwm6UBgRD2DQ

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
# Accounts are NOT seeded by default. Development only, never production.
SEED_DEMO_USERS=false
# SEEDED_USER_PASSWORD=use-a-unique-strong-password-with-16-characters-minimum

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Trust only reverse proxy IP addresses/CIDR ranges you control (never '*').
TRUSTED_PROXIES=127.0.0.1,::1
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Web Push (generate once with: php artisan webpush:vapid)
# Keep the private key secret and do not rotate the keypair after deployment.
VAPID_SUBJECT="mailto:admin@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
LOAN_HOLD_HOURS=24

TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

CHATIFY_STORAGE_DISK=public
CHATIFY_ROUTES_PREFIX=chatify
CHATIFY_CUSTOM_ROUTES=true

REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=9000

REVERB_HOST=invman.test
REVERB_PORT=9000

REVERB_APP_ID=your-app-id
REVERB_APP_KEY=your-app-key
REVERB_APP_SECRET=your-app-secret

REVERB_SCHEME=https

# Hosted Pusher Channels credentials. Leave PUSHER_HOST unset so the Pusher
# SDK derives the correct API/WebSocket endpoints from the cluster.
PUSHER_APP_ID=your-pusher-app-id
PUSHER_APP_KEY=your-pusher-app-key
PUSHER_APP_SECRET=your-pusher-app-secret
PUSHER_APP_CLUSTER=ap1
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

BROADCAST_DRIVER=pusher
